{
  "schemaVersion": 1,
  "id": "stardew_fishing",
  "version": "${version}",
  "name": "Stardew Fishing",
  "description": "Brings Stardew Valley's fishing minigame to Minecraft, and more.",
  "authors": [
    "bonker"
  ],
  "license": "MIT",
  "icon": "stardew_fishing.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.bonker.stardewfishing.StardewFishing"
    ],
    "client": [
      "com.bonker.stardewfishing.client.StardewFishingClient"
    ]
  },
  "mixins": [
    "stardew_fishing.mixins.json"
  ],
  "accessWidener": "stardew_fishing.accesswidener",
  "depends": {
    "java": ">=21",
    "minecraft": "=1.21.1",
    "fabricloader": ">=0.16.9",
    "fabric-api": "*"
  },
  "suggests": {
    "tide": "*",
    "cobblemon": "*",
    "netherdepthsupgrade": "*",
    "fishingreal": "*"
  }
}
