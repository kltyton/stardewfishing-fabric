{
  "schemaVersion": 1,
  "id": "stardew_fishing",
  "version": "${version}",
  "name": "Stardew Fishing (Fabric)",
  "description": "A complete Fabric port of Stardew Fishing 3.7 for Minecraft 1.20.1.",
  "authors": [
    "bonker",
    "kltyton"
  ],
  "contact": {
    "website": "https://github.com/kltyton/stardewfishing-fabric",
    "repo": "https://github.com/kltyton/stardewfishing-fabric"
  },
  "license": "MIT",
  "icon": "assets/stardew_fishing/icon.png",
  "environment": "*",
  "entrypoints": {
    "client": [
      "com.kltyton.stardewfishingFabric.client.ClientEvents"
    ],
    "main": [
      "com.kltyton.stardewfishingFabric.StardewfishingFabric"
    ]
  },
  "mixins": [
    "stardewfishing-fabric.mixins.json"
  ],
  "depends": {
    "java": ">=17",
    "fabricloader": ">=${loader_version}",
    "fabric-api": ">=${fabric_version}",
    "forgeconfigapiport": ">=8.0.2",
    "minecraft": ">=1.20.1 <1.20.2"
  },
  "suggests": {
    "aquaculture": "*",
    "tide": "*",
    "netherdepthsupgrade": "*",
    "quality_food": "*",
    "supplementaries": "*",
    "quark": "*",
    "crittersandcompanions": "*",
    "fishingreal": "*",
    "jobsaddon": "*"
  },
  "accessWidener": "stardewfishing-fabric.accesswidener"
}
